{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wa-audit/analysis.schema.json",
  "title": "wa-audit analysis contract v1",
  "description": "Contract between any analysis engine (LLM, rules, SQL, humans) and the report generator. A dimension WITHOUT a verdict is INVALID by design: unverified analysis must not reach the report.",
  "type": "object",
  "required": ["schema_version", "dimensions"],
  "properties": {
    "schema_version": { "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension" }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["key", "title", "summary", "findings", "columns", "rows", "method", "limitations", "verdict"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["n"],
            "properties": { "n": { "type": ["integer", "string"] } }
          }
        },
        "method": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "verdict": { "$ref": "#/$defs/verdict" },
        "row_verification_notes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["title", "detail", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "frequency": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["thread_id", "quote"],
            "properties": {
              "thread_id": { "type": "string" },
              "quote": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["reviewed", "confirmed", "refuted"],
      "properties": {
        "reviewed": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "refuted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "reason"],
            "properties": {
              "title": { "type": "string" },
              "reason": { "type": "string" },
              "correction": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
