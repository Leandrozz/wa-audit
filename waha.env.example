# Copy to waha.env and fill in. Load with:  node --env-file=waha.env src/<phase>.mjs
# waha.env is gitignored — never commit real credentials.

# URL of your WAHA instance. No default on purpose: accidentally pointing at
# the wrong instance is the expensive mistake this refuses to make for you.
WAHA_BASE_URL=https://waha.example.com

# X-Api-Key header of the WAHA instance.
WAHA_API_KEY=change-me

# Only if the instance sits behind nginx Basic Auth: "user:password"
#WAHA_BASIC_AUTH=user:password

# Session name (alternative to passing it as an argument / --session)
#WAHA_SESSION=default

# Where the dump + corpus are written (gitignored: these are real chats)
#WA_OUT_DIR=data/wa-history

# Interim identity knobs (a proper config file replaces these in v0.2)
#WA_BUSINESS_NAME=My Business
#WA_INTERNAL_EMAIL_DOMAINS=mycompany.com,mycompany.com.ar
