# Copy to kapso.env and fill in. Load with:  node --env-file=kapso.env src/export-kapso.mjs
# kapso.env is gitignored — never commit real credentials.

# Project API key from https://app.kapso.ai (sent as X-API-Key)
KAPSO_API_KEY=change-me

# The WhatsApp phone number id of the number to audit, as shown in Kapso
KAPSO_PHONE_NUMBER_ID=change-me

# Optional: only export messages on/after this ISO 8601 instant
#KAPSO_SINCE=2026-01-01T00:00:00Z

# Optional overrides
#KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
#WA_OUT_DIR=data/wa-history
