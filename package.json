{
  "name": "wa-audit",
  "version": "0.1.0",
  "description": "Commercial audit of a WhatsApp business number: WAHA history export → clean corpus → verified LLM analysis → multi-sheet XLSX report. Self-hosted, nothing leaves your machine.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "node src/probe.mjs",
    "export": "node src/export.mjs",
    "export:kapso": "node src/export-kapso.mjs",
    "threads": "node src/threads.mjs",
    "analyze": "node src/analyze.mjs",
    "check:analysis": "node tools/check-analysis.mjs",
    "report": "node src/report-xlsx.mjs",
    "report:html": "node src/report-html.mjs",
    "report:docx": "node src/report-docx.mjs",
    "demo": "node tools/demo.mjs",
    "mcp": "node src/mcp-server.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.0",
    "cfb": "^1.2.2",
    "docx": "^9.7.1",
    "libphonenumber-js": "^1.11.0",
    "xlsx": "0.18.5",
    "zod": "^4.4.3"
  }
}
